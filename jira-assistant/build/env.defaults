# Provider defaults for a customized AnythingLLM Desktop build.
#
# Bake the non-secret keys into the bundled server .env at BUILD time. The
# secret-dependent keys (GENERIC_OPEN_AI_API_KEY and the x-portkey-* header
# values) are filled in at FIRST RUN by build/seed.cjs from the user's input.
#
# See ../DECISIONS.md for why these route through Portkey via the Generic OpenAI
# provider and how the x-portkey-* headers are passed.

LLM_PROVIDER=generic-openai

# Portkey gateway (OpenAI-compatible). Override if you use a self-hosted gateway.
GENERIC_OPEN_AI_BASE_PATH=https://api.portkey.ai/v1

# Default model the assistant uses. Change to your Portkey-routed model id.
GENERIC_OPEN_AI_MODEL_PREF=claude-sonnet-4-6

# Context window + per-response cap. Tune to the routed model.
GENERIC_OPEN_AI_MODEL_TOKEN_LIMIT=8192
GENERIC_OPEN_AI_MAX_TOKENS=1024

# Filled in by seed.cjs at first run (do NOT commit real values):
#   GENERIC_OPEN_AI_API_KEY=<PORTKEY_API_KEY>
#   GENERIC_OPEN_AI_CUSTOM_HEADERS="x-portkey-virtual-key:<vk>"   # or x-portkey-config:<id>
