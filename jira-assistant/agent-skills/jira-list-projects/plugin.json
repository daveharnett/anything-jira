{
  "active": false,
  "hubId": "jira-list-projects",
  "name": "List Jira Projects",
  "schema": "skill-1.0.0",
  "version": "1.0.0",
  "description": "Lists Jira projects the user can access (key and name). Use to list projects or find a project key.",
  "author": "anything-jira",
  "license": "MIT",
  "setup_args": {
    "JIRA_BASE_URL": {
      "type": "string",
      "required": true,
      "input": {
        "type": "text",
        "default": "",
        "placeholder": "https://jira.your-company.com",
        "hint": "Base URL of your Jira Server / Data Center instance."
      },
      "value": ""
    },
    "JIRA_PAT": {
      "type": "string",
      "required": true,
      "input": {
        "type": "password",
        "default": "",
        "placeholder": "Your Jira personal access token",
        "hint": "Jira Data Center Personal Access Token. Sent as a Bearer token. Stored locally in this skill's plugin.json."
      },
      "value": ""
    }
  },
  "entrypoint": {
    "file": "handler.js",
    "params": {
      "contains": {
        "description": "Optional case-insensitive filter on project name or key.",
        "type": "string"
      }
    }
  },
  "examples": [
    {
      "prompt": "what projects can I see",
      "call": "{}"
    },
    {
      "prompt": "find the platform project",
      "call": "{\"contains\":\"platform\"}"
    }
  ],
  "imported": true
}
